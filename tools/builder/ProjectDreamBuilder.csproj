<Project Sdk="Microsoft.NET.Sdk">
  <!-- projectdream_builder: the Switch port's game file (sdt.apk) from the player's own macOS Sonic Dream Team and their
       own Project_Dream.exe, whose code it runs (nothing of Project Dream is in this project). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>projectdream_builder</AssemblyName>
    <RootNamespace>ProjectDreamBuilder</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Version>1.0.0</Version>
    <!-- release builds (tools/builder/publish.sh): one self-contained file per platform, nothing to install -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Project Dream's code is loaded at run time and reached by reflection: nothing may be trimmed -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
  </ItemGroup>
</Project>
